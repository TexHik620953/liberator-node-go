	router := network.NewRouter(routingTable, firewall)
	
	// 3. Создаем физическое подключение (Сокет)
	udpConn, _ := net.ListenUDP("udp", &net.UDPAddr{Port: 51820})
	
	// 4. Создаем двусторонний Транспорт и передаем ему Роутер
	wgTransport := ingress.NewWireguardTransport("wg-main", udpConn, router)
	
