    "version": "0.2.0",
    "configurations": [

        {
            "name": "Launch Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/node/main.go",
            "console": "integratedTerminal",
            "asRoot": true,
            "cwd": ".",
            "args": ["./config.yaml"]
        },
        {
            "name": "Generate certificates",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/certgen/main.go",
            "console": "integratedTerminal",
            "asRoot": false,
            "cwd": "."
        }
    ]
}